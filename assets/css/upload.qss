/* ================================================
   upload.qss – Styling voor ImageUploader (test_oitmi_upload.py)
   ================================================ */

/* ----------------------------------------------
   1. Hoofdvenster (ImageUploader als QWidget Window)
   ---------------------------------------------- */
ImageUploader, ImageUploader QWidget {
    background-color: #ffffff;                       /* wittige achtergrond */
    font-family: "Segoe UI", Verdana, Arial, sans-serif;
    font-size: 11px;
    color: #333333;
}

/* ----------------------------------------------
   2. Titellabels (QLabel)  
      – de labels voor “Beschrijving”, “Artikelnummer”, enz.
   ---------------------------------------------- */
ImageUploader QLabel {
    font-size: 11px;
    color: #333333;
    margin-top: 8px;
    margin-bottom: 2px;
}

/* ----------------------------------------------
   3. QLineEdit (invoervelden)
      – beschrijving, artikelnummer, weblink, vendor­gegevens, OITMI_ID, URL-veld
   ---------------------------------------------- */
ImageUploader QLineEdit {
    padding: 4px;
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: #ffffff;
    color: #333333;
    font-size: 11px;
}

ImageUploader QLineEdit:focus {
    border: 1px solid #66afe9;  /* accentkleur bij focus */
    outline: none;
}

ImageUploader QLineEdit:read-only {
    background-color: #f5f5f5;
    color: #555555;
}

/* Placeholdertekst iets gedimd */
ImageUploader QLineEdit[placeholderText] {
    color: #999999;
}

/* ----------------------------------------------
   4. QComboBox (“TYPE” keuzelijst)
   ---------------------------------------------- */
ImageUploader QComboBox {
    padding: 4px;
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: #ffffff;
    color: #333333;
    font-size: 11px;
}

ImageUploader QComboBox:focus {
    border: 1px solid #66afe9;
    outline: none;
}

ImageUploader QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #cccccc;
}

ImageUploader QComboBox::down-arrow {
    image: url(:/icons/arrow-down.png);  /* zorg dat dit icoon in je resources zit */
    width: 12px;
    height: 12px;
}

ImageUploader QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    selection-background-color: #e6f2ff;
    selection-color: #333333;
    font-size: 11px;
}

/* Disabled state */
ImageUploader QComboBox:disabled {
    background-color: #f5f5f5;
    color: #aaaaaa;
}

/* ----------------------------------------------
   5. QSpinBox (“Breedte (pixels)”)  
   ---------------------------------------------- */
ImageUploader QSpinBox {
    padding: 4px;
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: #ffffff;
    color: #333333;
    font-size: 11px;
}

ImageUploader QSpinBox:focus {
    border: 1px solid #66afe9;
    outline: none;
}

ImageUploader QSpinBox::up-button, 
ImageUploader QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #cccccc;
    border-bottom: 1px solid #cccccc;
}

ImageUploader QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-top: 1px solid #cccccc;
}

ImageUploader QSpinBox::up-arrow {
    image: url(:/icons/arrow-up.png);
    width: 8px;
    height: 8px;
}

ImageUploader QSpinBox::down-arrow {
    image: url(:/icons/arrow-down.png);
    width: 8px;
    height: 8px;
}

/* ----------------------------------------------
   6. QTextEdit (“Base64 PNG output”)
   ---------------------------------------------- */
ImageUploader QTextEdit {
    padding: 4px;
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: #fafafa;
    color: #333333;
    font-size: 11px;
}

/* ----------------------------------------------
   7. QPushButton (knoppen: convert, upload, send)
   ---------------------------------------------- */
ImageUploader QPushButton {
    padding: 6px 12px;
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 4px;
    color: #333333;
    font-size: 11px;
}

ImageUploader QPushButton:hover {
    background-color: #e6e6e6;
}

ImageUploader QPushButton:pressed {
    background-color: #d4d4d4;
}

ImageUploader QPushButton:focus {
    outline: none;
    border: 1px solid #66afe9;
}

ImageUploader QPushButton:disabled {
    background-color: #eeeeee;
    color: #aaaaaa;
    border: 1px solid #dddddd;
}

/* ----------------------------------------------
   8. QFileDialog (als je een bestand kiest)
   ---------------------------------------------- */
/* Je kunt QFileDialog stylen, maar vaak volstaat de systeemlook. 
   Voor het geval je iets wilt aanpassen, bijvoorbeeld achtergrond: */
QFileDialog {
    background-color: #ffffff;
    font-family: "Segoe UI", Verdana, Arial, sans-serif;
    font-size: 11px;
    color: #333333;
}

/* ----------------------------------------------
   9. Foutmeldingen en QMessageBox  
   ---------------------------------------------- */
ImageUploader QMessageBox {
    background-color: #f9f9f9;
    font-size: 11px;
    color: #333333;
}

/* ----------------------------------------------
   10. Scrollbars (indien in de toekomst nodig)
   ---------------------------------------------- */
ImageUploader QScrollBar:vertical {
    background: #f0f0f0;
    width: 12px;
    margin: 0px;
}

ImageUploader QScrollBar::handle:vertical {
    background: #cccccc;
    min-height: 20px;
    border-radius: 4px;
}

ImageUploader QScrollBar::add-line:vertical, 
ImageUploader QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}

ImageUploader QScrollBar:horizontal {
    background: #f0f0f0;
    height: 12px;
    margin: 0px;
}

ImageUploader QScrollBar::handle:horizontal {
    background: #cccccc;
    min-width: 20px;
    border-radius: 4px;
}

ImageUploader QScrollBar::add-line:horizontal, 
ImageUploader QScrollBar::sub-line:horizontal {
    background: none;
    width: 0px;
}

/* ----------------------------------------------
   11. Focus‐outline voor child‐widgets
   ---------------------------------------------- */
ImageUploader QWidget:focus {
    outline: 1px dotted #66afe9;
}

/* ----------------------------------------------
   12. Extra objectName-selectors (optioneel)
   ---------------------------------------------- */
/* Je kunt per widget in code setObjectName( "mijnNaam" ) aanroepen 
   en hier extra stijlen koppelen, bv.: */
/*
ImageUploader QLineEdit#url_input {
    background-color: #ffffee;
}

ImageUploader QPushButton#convert_button {
    background-color: #f0f8ff;
    border: 1px solid #66afe9;
}
*/
